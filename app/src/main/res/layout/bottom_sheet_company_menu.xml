<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">



    <View
        android:id="@+id/dragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#D6D6D6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>



    <ImageView
        android:id="@+id/imgCompany"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_circle"
        android:padding="12dp"
        android:src="@drawable/ic_user_profile"
        app:layout_constraintTop_toBottomOf="@id/dragHandle"
        app:layout_constraintStart_toStartOf="parent"/>



    <TextView
        android:id="@+id/txtCompanyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Marketing Team"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/imgCompany"
        app:layout_constraintTop_toTopOf="@id/imgCompany"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Manage workspace settings"
        android:textSize="14sp"
        android:textColor="#777"
        app:layout_constraintStart_toStartOf="@id/txtCompanyTitle"
        app:layout_constraintTop_toBottomOf="@id/txtCompanyTitle"
        app:layout_constraintEnd_toEndOf="parent"/>


    <ImageView
        android:id="@+id/iconEdit"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/ic_edit_workspace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgCompany"/>


    <TextView
        android:id="@+id/btnEdit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Edit Workspace"
        android:textSize="16sp"

        android:textColor="#137fec"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/iconEdit"
        app:layout_constraintTop_toTopOf="@id/iconEdit"
        app:layout_constraintBottom_toBottomOf="@id/iconEdit"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnActivate"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_activate_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iconEdit">


        <ImageView
            android:id="@+id/iconActivate"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_activate_workspace"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/txtActivate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Activate Workspace"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/iconActivate"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/iconRemove"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/ic_remove_workspace"
        app:layout_constraintTop_toBottomOf="@id/btnActivate"
        app:layout_constraintStart_toStartOf="parent"/>


    <TextView
        android:id="@+id/btnRemove"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Remove Workspace"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#E53935"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/iconRemove"
        app:layout_constraintTop_toTopOf="@id/iconRemove"
        app:layout_constraintBottom_toBottomOf="@id/iconRemove"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>