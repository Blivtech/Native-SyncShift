<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_margin="5dp"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardShift"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:src="@android:drawable/ic_menu_gallery"/>

            <!-- Shift Name -->
            <TextView
                android:id="@+id/txtShiftName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Day Shift"
                android:textSize="@dimen/text_medium_16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_medium"
                app:layout_constraintStart_toEndOf="@id/imgIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/checkBox"
                android:layout_marginStart="12dp"/>

            <!-- Shift Time -->
            <TextView
                android:id="@+id/txtShiftTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="08:00 AM - 04:00 PM"
                android:textColor="@color/button_color"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@id/txtShiftName"
                app:layout_constraintTop_toBottomOf="@id/txtShiftName"
                app:layout_constraintEnd_toStartOf="@id/checkBox"
                android:layout_marginTop="4dp"/>

            <!-- Checkbox -->
            <CheckBox
                android:id="@+id/checkBox"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:button="@null"
                android:background="@drawable/checkbox_selector"
                android:gravity="center"
                android:drawablePadding="2dp"
                android:drawableStart="@drawable/ic_check"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>