<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FB">

    <!-- Company Pill (Center + Arrow inside) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clCompany"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_company_pill"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tvCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLIVTECH PRIVATE LIMITED"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/icArrow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_arrow_down"
            app:layout_constraintStart_toEndOf="@id/tvCompany"
            app:layout_constraintTop_toTopOf="@id/tvCompany"
            app:layout_constraintBottom_toBottomOf="@id/tvCompany"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 🔹 EMPLOYEE CARD (CardView) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvEmployee"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"


        app:layout_constraintTop_toBottomOf="@id/clCompany"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:padding="12dp">

            <!-- Profile Image -->
            <ImageView
                android:id="@+id/imgEmp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_user_profile"
                android:background="@drawable/bg_circle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Name -->
            <TextView
                android:id="@+id/tvEmpName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alex Johnson"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@id/imgEmp"
                app:layout_constraintTop_toTopOf="@id/imgEmp"/>

            <!-- Emp ID (Separate view – OK as you said) -->
            <TextView
                android:id="@+id/tvEmpId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMP - 1024"
                android:textSize="11sp"
                android:textColor="#555"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_version_chip"
                app:layout_constraintStart_toStartOf="@id/tvEmpName"
                app:layout_constraintTop_toBottomOf="@id/tvEmpName"
                android:layout_marginTop="4dp"/>

            <!-- Version chip -->
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="92dp"
                android:background="@drawable/bg_version_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="v2.4.5"
                android:textColor="#444"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Day -->
    <TextView
        android:id="@+id/tvDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monday"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000"
        android:layout_marginTop="10dp"

        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/cvEmployee"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Calendar -->
    <ImageView
        android:id="@+id/icCalendar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_ccalendar"
        android:layout_marginTop="10dp"

        android:padding="8dp"
        android:background="@drawable/bg_circle_white"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tvDay"
        app:layout_constraintBottom_toBottomOf="@id/tvDay"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Date -->
    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="October 24, 2023"
        android:textSize="14sp"
        android:textColor="#777"
        app:layout_constraintTop_toBottomOf="@id/tvDay"
        app:layout_constraintStart_toStartOf="@id/tvDay"/>

    <!-- Shift Header -->
    <TextView
        android:id="@+id/tvShiftTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shift Wise Attendance"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvDate"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvTodayOverview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today’s Overview"
        android:textSize="13sp"
        android:textColor="#8A8A8A"
        android:layout_marginEnd="16dp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvShiftTitle"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SINGLE RecyclerView for ALL SHIFTS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvShiftAttendance"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvShiftTitle"
        app:layout_constraintVertical_bias="1.0" />


</androidx.constraintlayout.widget.ConstraintLayout>
