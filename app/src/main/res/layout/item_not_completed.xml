<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:background="@drawable/bg_dotted_border">

        <!-- SHIFT ICON -->
        <ImageView
            android:id="@+id/imgShiftIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_shift_icon"
            android:padding="8dp"
            android:src="@drawable/ic_nightshift"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- SHIFT NAME -->
        <TextView
            android:id="@+id/tvShiftName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Night Shift"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"
            app:layout_constraintStart_toEndOf="@id/imgShiftIcon"
            app:layout_constraintTop_toTopOf="@id/imgShiftIcon"
            app:layout_constraintEnd_toStartOf="@id/layoutStatus"/>

        <!-- SHIFT TIME -->
        <TextView
            android:id="@+id/tvShiftTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:00 AM - 08:00 AM"
            android:textSize="13sp"
            android:textColor="#757575"
            app:layout_constraintStart_toStartOf="@id/tvShiftName"
            app:layout_constraintTop_toBottomOf="@id/tvShiftName"/>

        <!-- NOT COMPLETED BADGE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:background="@drawable/bg_not_completed"
            app:layout_constraintTop_toTopOf="@id/imgShiftIcon"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imgClock"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="NOT COMPLETED"
                android:textSize="12sp"
                android:textColor="#F57C00"
                app:layout_constraintStart_toEndOf="@id/imgClock"
                app:layout_constraintTop_toTopOf="@id/imgClock"
                app:layout_constraintBottom_toBottomOf="@id/imgClock"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- DO ATTENDANCE BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDoAttendance"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:text="Do Attendance"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="@android:color/white"
            app:backgroundTint="#1E88E5"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/imgShiftIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
